<!--
ClassroomToolkit Visual Design System 2.0
Template only. Adapt namespace/file paths to the repository.
Use DynamicResource for theme-dependent colors/brushes.
Use StaticResource for invariant dimensions/typography where appropriate.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =======================
         Geometry / Metrics
         ======================= -->
    <sys:Double x:Key="CTK.Size.Control.Compact"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
    <sys:Double x:Key="CTK.Size.Control.Default"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">36</sys:Double>
    <sys:Double x:Key="CTK.Size.Button.Default"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">40</sys:Double>
    <sys:Double x:Key="CTK.Size.Button.Primary"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">44</sys:Double>
    <sys:Double x:Key="CTK.Size.TitleBar"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">46</sys:Double>
    <sys:Double x:Key="CTK.Size.Toolbar"
                xmlns:sys="clr-namespace:System;assembly=mscorlib">52</sys:Double>

    <CornerRadius x:Key="CTK.Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="CTK.Radius.Button">7</CornerRadius>
    <CornerRadius x:Key="CTK.Radius.Panel">8</CornerRadius>
    <CornerRadius x:Key="CTK.Radius.Window">10</CornerRadius>
    <CornerRadius x:Key="CTK.Radius.Toolbar">16</CornerRadius>

    <Thickness x:Key="CTK.Padding.Control">12,8</Thickness>
    <Thickness x:Key="CTK.Padding.Dialog">24</Thickness>

    <!-- =======================
         Typography
         ======================= -->
    <FontFamily x:Key="CTK.Font.UI">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="CTK.Font.Numeric">Segoe UI Variable Display</FontFamily>

    <!-- =======================
         Theme colors
         NOTE:
         Move this section into per-theme dictionaries in production.
         ======================= -->
    <Color x:Key="CTK.Color.Canvas">#0E1418</Color>
    <Color x:Key="CTK.Color.Window">#111A1F</Color>
    <Color x:Key="CTK.Color.Surface">#172126</Color>
    <Color x:Key="CTK.Color.SurfaceAlt">#1C282E</Color>
    <Color x:Key="CTK.Color.Hover">#25343B</Color>
    <Color x:Key="CTK.Color.Pressed">#2B3B43</Color>
    <Color x:Key="CTK.Color.BorderDefault">#34464E</Color>
    <Color x:Key="CTK.Color.BorderFocus">#55D8C4</Color>
    <Color x:Key="CTK.Color.TextPrimary">#F3F7F6</Color>
    <Color x:Key="CTK.Color.TextSecondary">#AAB9B5</Color>
    <Color x:Key="CTK.Color.TextDisabled">#5F6E6A</Color>
    <Color x:Key="CTK.Color.TextOnPrimary">#081512</Color>
    <Color x:Key="CTK.Color.Primary">#35C7B0</Color>
    <Color x:Key="CTK.Color.PrimaryHover">#49D4C0</Color>
    <Color x:Key="CTK.Color.PrimaryPressed">#28A58F</Color>
    <Color x:Key="CTK.Color.PrimarySoft">#183A34</Color>
    <Color x:Key="CTK.Color.Warning">#D7A23A</Color>
    <Color x:Key="CTK.Color.WarningSoft">#3A2C16</Color>
    <Color x:Key="CTK.Color.Danger">#E56570</Color>
    <Color x:Key="CTK.Color.DangerSoft">#3D2024</Color>

    <SolidColorBrush x:Key="CTK.Brush.Canvas"
                     Color="{DynamicResource CTK.Color.Canvas}" />
    <SolidColorBrush x:Key="CTK.Brush.Window"
                     Color="{DynamicResource CTK.Color.Window}" />
    <SolidColorBrush x:Key="CTK.Brush.Surface"
                     Color="{DynamicResource CTK.Color.Surface}" />
    <SolidColorBrush x:Key="CTK.Brush.SurfaceAlt"
                     Color="{DynamicResource CTK.Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="CTK.Brush.Hover"
                     Color="{DynamicResource CTK.Color.Hover}" />
    <SolidColorBrush x:Key="CTK.Brush.Pressed"
                     Color="{DynamicResource CTK.Color.Pressed}" />
    <SolidColorBrush x:Key="CTK.Brush.Border.Default"
                     Color="{DynamicResource CTK.Color.BorderDefault}" />
    <SolidColorBrush x:Key="CTK.Brush.Border.Focus"
                     Color="{DynamicResource CTK.Color.BorderFocus}" />
    <SolidColorBrush x:Key="CTK.Brush.Text.Primary"
                     Color="{DynamicResource CTK.Color.TextPrimary}" />
    <SolidColorBrush x:Key="CTK.Brush.Text.Secondary"
                     Color="{DynamicResource CTK.Color.TextSecondary}" />
    <SolidColorBrush x:Key="CTK.Brush.Text.Disabled"
                     Color="{DynamicResource CTK.Color.TextDisabled}" />
    <SolidColorBrush x:Key="CTK.Brush.Text.OnPrimary"
                     Color="{DynamicResource CTK.Color.TextOnPrimary}" />
    <SolidColorBrush x:Key="CTK.Brush.Primary"
                     Color="{DynamicResource CTK.Color.Primary}" />
    <SolidColorBrush x:Key="CTK.Brush.Primary.Hover"
                     Color="{DynamicResource CTK.Color.PrimaryHover}" />
    <SolidColorBrush x:Key="CTK.Brush.Primary.Pressed"
                     Color="{DynamicResource CTK.Color.PrimaryPressed}" />
    <SolidColorBrush x:Key="CTK.Brush.Primary.Soft"
                     Color="{DynamicResource CTK.Color.PrimarySoft}" />
    <SolidColorBrush x:Key="CTK.Brush.Warning"
                     Color="{DynamicResource CTK.Color.Warning}" />
    <SolidColorBrush x:Key="CTK.Brush.Warning.Soft"
                     Color="{DynamicResource CTK.Color.WarningSoft}" />
    <SolidColorBrush x:Key="CTK.Brush.Danger"
                     Color="{DynamicResource CTK.Color.Danger}" />
    <SolidColorBrush x:Key="CTK.Brush.Danger.Soft"
                     Color="{DynamicResource CTK.Color.DangerSoft}" />

    <!-- =======================
         Base Text
         ======================= -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CTK.Font.UI}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Primary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- =======================
         Base Button
         ======================= -->
    <Style x:Key="CTK.Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource CTK.Font.UI}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MinHeight" Value="{StaticResource CTK.Size.Button.Default}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <!--
        Production implementation should use one shared ControlTemplate
        with VisualStateManager / triggers for Hover, Pressed, Disabled, Focused.
        Do NOT duplicate button templates per window.
        -->
    </Style>

    <Style x:Key="CTK.Button.Primary"
           TargetType="Button"
           BasedOn="{StaticResource CTK.Button.Base}">
        <Setter Property="MinHeight" Value="{StaticResource CTK.Size.Button.Primary}" />
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.OnPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="CTK.Button.Warning"
           TargetType="Button"
           BasedOn="{StaticResource CTK.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.Warning.Soft}" />
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Warning}" />
    </Style>

    <Style x:Key="CTK.Button.Danger"
           TargetType="Button"
           BasedOn="{StaticResource CTK.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.Danger.Soft}" />
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Danger}" />
    </Style>

</ResourceDictionary>
