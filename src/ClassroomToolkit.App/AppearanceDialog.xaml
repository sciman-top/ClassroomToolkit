<Window x:Class="ClassroomToolkit.App.AppearanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外观"
        Height="Auto" Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Style="{StaticResource Style_DialogShellWindowBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Style="{StaticResource Style_DialogShellTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Style="{StaticResource Style_TitleIconBadge}" Margin="0,0,8,0">
                        <Path Data="{StaticResource Icon_Palette}" Fill="{DynamicResource Brush_Primary}" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="外观" Style="{StaticResource Style_DialogShellTitleText}" Margin="0"/>
                </StackPanel>
                <Button Style="{StaticResource Style_DialogShellCloseButton}" Click="OnClose" ToolTip="关闭">
                    <Path Data="{StaticResource Icon_Close}" Fill="{DynamicResource Brush_Text_Secondary}" Stretch="Uniform"
                          Width="{StaticResource Size_Icon_Glyph_MD}" Height="{StaticResource Size_Icon_Glyph_MD}"/>
                </Button>
            </Grid>
            <Border Grid.Row="0" Style="{StaticResource Style_DialogShellDivider}"/>

            <Border Grid.Row="1" Margin="20,16,20,8" Style="{StaticResource Style_SettingCardBorder}" Padding="14">
                <StackPanel>
                    <TextBlock Text="主题" Style="{StaticResource Style_FieldLabelText}" Margin="0,0,0,8"/>
                    <RadioButton x:Name="MidnightTealRadio" GroupName="Theme" Margin="0,0,0,8"
                                 Content="课堂深色（推荐）" MinHeight="32" Checked="OnThemeChecked" Tag="MidnightTeal"/>
                    <RadioButton x:Name="BlackboardRadio" GroupName="Theme" Margin="0,0,0,8"
                                 Content="黑板护眼" MinHeight="32" Checked="OnThemeChecked" Tag="Blackboard"/>
                    <RadioButton x:Name="LightRadio" GroupName="Theme"
                                 Content="明亮" MinHeight="32" Checked="OnThemeChecked" Tag="Light"/>
                    <TextBlock Text="选择后立即切换并保存，不会中断点名、计时或悬浮工具。"
                               Style="{StaticResource Style_HelperText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Style="{StaticResource Style_DialogShellActionBar}">
                <Button Content="完成" Style="{StaticResource Style_DialogShellPrimaryActionButton}" Click="OnClose"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
