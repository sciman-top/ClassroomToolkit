<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compatibility seam: existing feature XAML resolves these keys while their values follow CTK semantic tokens. -->
    <SolidColorBrush x:Key="Brush_AppBackground" Color="{DynamicResource CTK.Color.Canvas}"/>
    <SolidColorBrush x:Key="Brush_Surface_Primary" Color="{DynamicResource CTK.Color.Surface}"/>
    <SolidColorBrush x:Key="Brush_Surface_Secondary" Color="{DynamicResource CTK.Color.SurfaceAlt}"/>
    <SolidColorBrush x:Key="Brush_InputBackground" Color="{DynamicResource CTK.Color.SurfaceElevated}"/>
    <SolidColorBrush x:Key="Brush_OverlayMask" Color="{DynamicResource CTK.Color.Overlay}"/>
    <SolidColorBrush x:Key="Brush_GlassSurface" Color="{DynamicResource CTK.Color.OverlayToolbar}"/>
    <SolidColorBrush x:Key="Brush_Text_Primary" Color="{DynamicResource CTK.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush_Text_Secondary" Color="{DynamicResource CTK.Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush_Text_Tertiary" Color="{DynamicResource CTK.Color.TextTertiary}"/>
    <SolidColorBrush x:Key="Brush_Primary" Color="{DynamicResource CTK.Color.Primary}"/>
    <SolidColorBrush x:Key="Brush_Primary_Hover" Color="{DynamicResource CTK.Color.PrimaryHover}"/>
    <SolidColorBrush x:Key="Brush_Primary_Dark" Color="{DynamicResource CTK.Color.PrimaryPressed}"/>
    <SolidColorBrush x:Key="Brush_Primary_Light" Color="{DynamicResource CTK.Color.PrimaryHover}"/>
    <SolidColorBrush x:Key="Brush_Success" Color="{DynamicResource CTK.Color.Success}"/>
    <SolidColorBrush x:Key="Brush_Warning" Color="{DynamicResource CTK.Color.Warning}"/>
    <SolidColorBrush x:Key="Brush_Danger" Color="{DynamicResource CTK.Color.Danger}"/>
    <SolidColorBrush x:Key="Brush_Border_Subtle" Color="{DynamicResource CTK.Color.BorderSubtle}"/>
    <SolidColorBrush x:Key="Brush_Border_Strong" Color="{DynamicResource CTK.Color.BorderDefault}"/>
    <SolidColorBrush x:Key="Brush_Border_Focus" Color="{DynamicResource CTK.Color.BorderFocus}"/>
    <SolidColorBrush x:Key="Brush_Border_Active" Color="{DynamicResource CTK.Color.Primary}"/>
    <SolidColorBrush x:Key="Brush_Border_Glass" Color="{DynamicResource CTK.Color.BorderSubtle}"/>
    <SolidColorBrush x:Key="Brush_Disabled" Color="{DynamicResource CTK.Color.TextDisabled}" Opacity="0.65"/>
    <SolidColorBrush x:Key="Brush_Foreground" Color="{DynamicResource CTK.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush_White_Translucent" Color="{DynamicResource CTK.Color.SelectionOverlay}"/>
    <SolidColorBrush x:Key="Brush_White_Translucent_Low" Color="{DynamicResource CTK.Color.SelectionOverlaySoft}"/>
    <SolidColorBrush x:Key="Brush_Timer_Display" Color="{DynamicResource CTK.Color.Primary}"/>
    <SolidColorBrush x:Key="Brush_Pen_Red" Color="{DynamicResource CTK.Color.Danger}"/>
    <SolidColorBrush x:Key="Brush_Pen_Blue" Color="{DynamicResource CTK.Color.Info}"/>
    <SolidColorBrush x:Key="Brush_Background" Color="{DynamicResource CTK.Color.Canvas}"/>
    <SolidColorBrush x:Key="Brush_Window_Atmosphere" Color="{DynamicResource CTK.Color.Window}"/>
    <SolidColorBrush x:Key="Brush_Background_L2" Color="{DynamicResource CTK.Color.Surface}"/>
    <SolidColorBrush x:Key="Brush_Background_L3" Color="{DynamicResource CTK.Color.SurfaceElevated}"/>
    <SolidColorBrush x:Key="Brush_Glass_Surface" Color="{DynamicResource CTK.Color.OverlayToolbar}"/>
    <SolidColorBrush x:Key="Brush_Glass_Border" Color="{DynamicResource CTK.Color.BorderDefault}"/>
    <SolidColorBrush x:Key="Brush_Surface_Hover" Color="{DynamicResource CTK.Color.Hover}"/>
    <SolidColorBrush x:Key="Brush_Surface_Active" Color="{DynamicResource CTK.Color.Pressed}"/>
    <SolidColorBrush x:Key="Brush_Surface_Tint" Color="{DynamicResource CTK.Color.PrimarySoft}"/>
    <SolidColorBrush x:Key="Brush_Border" Color="{DynamicResource CTK.Color.BorderSubtle}"/>
    <SolidColorBrush x:Key="Brush_Border_Light" Color="{DynamicResource CTK.Color.BorderDefault}"/>
    <SolidColorBrush x:Key="Brush_Danger_Surface" Color="{DynamicResource CTK.Color.DangerSoft}"/>
    <SolidColorBrush x:Key="Brush_Overlay_Dark" Color="{DynamicResource CTK.Color.Overlay}"/>
    <SolidColorBrush x:Key="Brush_Timer_Neon" Color="{DynamicResource CTK.Color.Primary}"/>

    <LinearGradientBrush x:Key="Gradient_Primary_Subtle" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.Primary}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.PrimaryPressed}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Teaching_Subtle" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.Warning}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.WarningSoft}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Timer_Display" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.Primary}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.PrimaryHover}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Hero_Glow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.SurfaceAlt}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.Surface}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Shell_Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.Window}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.Canvas}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Card_Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.SurfaceAlt}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.Surface}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Panel_Surface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.SurfaceElevated}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.Surface}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Primary" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.Primary}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.PrimaryPressed}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Primary_Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.PrimaryHover}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.Primary}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Success" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.Success}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.SuccessSoft}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Danger" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.Danger}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.DangerPressed}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Warning" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.Warning}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.WarningSoft}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_RollCall_Card" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.SurfaceElevated}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.Surface}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Gradient_Launcher" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource CTK.Color.PrimarySoft}" Offset="0"/>
        <GradientStop Color="{DynamicResource CTK.Color.Window}" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="Shadow_Card" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="4" ShadowDepth="1" Opacity="0.16" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Card_Subtle" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="2" ShadowDepth="1" Opacity="0.08" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Dialog" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="12" ShadowDepth="4" Opacity="0.24" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Dialog_Heavy" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="14" ShadowDepth="4" Opacity="0.28" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Floating" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="8" ShadowDepth="2" Opacity="0.20" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Popup_Light" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="8" ShadowDepth="2" Opacity="0.20" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Popup_Medium" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="10" ShadowDepth="3" Opacity="0.24" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Glow_Primary" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="4" ShadowDepth="1" Opacity="0.12" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Glow_Teaching" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="4" ShadowDepth="1" Opacity="0.12" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Glow_Hero" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="4" ShadowDepth="1" Opacity="0.10" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Primary_Glow" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="4" ShadowDepth="1" Opacity="0.10" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Danger_Glow" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="4" ShadowDepth="1" Opacity="0.10" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="Shadow_Glass_Glow" Color="{DynamicResource CTK.Color.Shadow}" BlurRadius="4" ShadowDepth="1" Opacity="0.08" RenderingBias="Performance"/>
</ResourceDictionary>
