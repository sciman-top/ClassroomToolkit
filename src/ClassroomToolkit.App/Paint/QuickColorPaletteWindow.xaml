<Window x:Class="ClassroomToolkit.App.Paint.QuickColorPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷颜色"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="{DynamicResource Gradient_Shell_Surface}" BorderBrush="{DynamicResource Brush_Border_Subtle}" BorderThickness="1" CornerRadius="{StaticResource CTK.Radius.Panel}" Padding="5,5"
            TextElement.Foreground="{DynamicResource Brush_Text_Primary}">
        <Border.Effect>
            <StaticResource ResourceKey="Shadow_Popup_Light"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="颜色" FontSize="{StaticResource FontSize_Body_S}" FontWeight="SemiBold" Foreground="{DynamicResource Brush_Text_Tertiary}" Margin="4,0,0,4"/>
            <Border Background="{DynamicResource Brush_Surface_Primary}" CornerRadius="{StaticResource CTK.Radius.Panel}" Padding="4" BorderBrush="{DynamicResource Brush_Border_Subtle}" BorderThickness="1">
                <StackPanel x:Name="OptionsPanel" Orientation="Horizontal" />
            </Border>
            <TextBlock Text="粗细" FontSize="{StaticResource FontSize_Body_S}" FontWeight="SemiBold" Foreground="{DynamicResource Brush_Text_Tertiary}" Margin="4,8,0,4"/>
            <Border Background="{DynamicResource Brush_Surface_Primary}" CornerRadius="{StaticResource CTK.Radius.Panel}" Padding="4" BorderBrush="{DynamicResource Brush_Border_Subtle}" BorderThickness="1">
                <StackPanel x:Name="BrushSizeOptionsPanel" Orientation="Horizontal" />
            </Border>
        </StackPanel>
    </Border>
</Window>
