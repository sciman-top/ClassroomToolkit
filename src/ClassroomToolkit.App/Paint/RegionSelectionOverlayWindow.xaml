<Window x:Class="ClassroomToolkit.App.Paint.RegionSelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="{DynamicResource Brush_OverlayMask}"
        Focusable="True"
        Cursor="Cross"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        TouchDown="OnTouchDown"
        TouchMove="OnTouchMove"
        TouchUp="OnTouchUp">
    <Canvas x:Name="RootCanvas">
        <TextBlock x:Name="HintText"
                   Text="拖选区域，Enter 确认，Esc 取消"
                   Foreground="{DynamicResource CTK.Brush.Text.Primary}"
                   FontSize="{StaticResource FontSize_Title_Management}"
                   FontWeight="SemiBold"
                   Canvas.Left="20"
                   Canvas.Top="20"/>
        <Rectangle x:Name="SelectionRect"
                   Visibility="Collapsed"
                   Stroke="{DynamicResource Brush_Border_Focus}"
                   StrokeThickness="2"
                   Fill="{DynamicResource CTK.Brush.SelectionOverlay}"/>
    </Canvas>
</Window>
