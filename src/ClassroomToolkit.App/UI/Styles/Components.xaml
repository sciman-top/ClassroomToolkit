<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared component interface. Feature views should choose one of these semantic styles. -->
    <Style x:Key="CTK.FocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="-2"
                            BorderBrush="{DynamicResource CTK.Brush.Border.Focus}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource CTK.Radius.Control}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CTK.Button.Base" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource CTK.Size.Button.Default}"/>
        <Setter Property="MinWidth" Value="88"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontFamily" Value="{StaticResource CTK.Font.UI}"/>
        <Setter Property="FontSize" Value="{StaticResource CTK.FontSize.Button}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CTK.FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CTK.Radius.Button}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Default}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Default}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CTK.Brush.SurfaceAlt}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Subtle}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CTK.Button.Primary" TargetType="Button" BasedOn="{StaticResource CTK.Button.Base}">
        <Setter Property="MinHeight" Value="{StaticResource CTK.Size.Button.Primary}"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.OnPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Primary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CTK.Brush.Primary.Hover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Primary.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CTK.Brush.Primary.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource CTK.Brush.SurfaceAlt}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Subtle}"/>
                <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Disabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CTK.Button.Secondary" TargetType="Button" BasedOn="{StaticResource CTK.Button.Base}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CTK.Brush.Hover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Default}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CTK.Brush.Pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CTK.Button.Ghost" TargetType="Button" BasedOn="{StaticResource CTK.Button.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CTK.Brush.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CTK.Brush.Pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CTK.Button.Warning" TargetType="Button" BasedOn="{StaticResource CTK.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.Warning.Soft}"/>
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Warning}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Warning}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CTK.Brush.Warning}"/>
                <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.OnPrimary}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CTK.Brush.Warning}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CTK.Button.Danger" TargetType="Button" BasedOn="{StaticResource CTK.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.Danger.Soft}"/>
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Danger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CTK.Brush.Danger}"/>
                <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.OnPrimary}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CTK.Brush.Danger.Pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CTK.IconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource CTK.Size.IconButton}"/>
        <Setter Property="Height" Value="{StaticResource CTK.Size.IconButton}"/>
        <Setter Property="MinWidth" Value="{StaticResource CTK.Size.IconButton}"/>
        <Setter Property="MinHeight" Value="{StaticResource CTK.Size.IconButton}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Secondary}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CTK.FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CTK.Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CTK.Brush.Hover}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Subtle}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CTK.Brush.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CTK.ToggleButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource CTK.Size.Control.Default}"/>
        <Setter Property="Height" Value="{StaticResource CTK.Size.Control.Default}"/>
        <Setter Property="MinWidth" Value="{StaticResource CTK.Size.Control.Default}"/>
        <Setter Property="MinHeight" Value="{StaticResource CTK.Size.Control.Default}"/>
        <Setter Property="Padding" Value="{StaticResource CTK.Padding.Control}"/>
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Primary}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CTK.FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CTK.Radius.Button}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CTK.Brush.Hover}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Default}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CTK.Brush.Primary.Soft}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CTK.Brush.Primary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CTK.Brush.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CTK.ToolButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource CTK.Size.IconButton}"/>
        <Setter Property="Height" Value="{StaticResource CTK.Size.IconButton}"/>
        <Setter Property="MinWidth" Value="{StaticResource CTK.Size.IconButton}"/>
        <Setter Property="MinHeight" Value="{StaticResource CTK.Size.IconButton}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Secondary}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CTK.FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CTK.Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CTK.Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CTK.Brush.ToolActiveSoft}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CTK.Brush.Primary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.ToolActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CTK.CheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Primary}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CTK.FocusVisual}"/>
    </Style>
    <Style x:Key="CTK.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="{StaticResource CTK.Size.Control.Default}"/>
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Default}"/>
    </Style>
    <Style x:Key="CTK.Slider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CTK.FocusVisual}"/>
    </Style>

    <Style x:Key="CTK.SurfaceSection" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CTK.Radius.Panel}"/>
        <Setter Property="Padding" Value="{StaticResource CTK.Spacing.4}"/>
    </Style>
    <Style x:Key="CTK.FloatingToolbar" TargetType="Border">
        <Setter Property="MinHeight" Value="{StaticResource CTK.Size.Toolbar}"/>
        <Setter Property="Padding" Value="5,4"/>
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.OverlayToolbar}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Toolbar}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CTK.Radius.Toolbar}"/>
    </Style>

    <Style x:Key="CTK.ToolTip" TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.SurfaceElevated}"/>
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Default}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="{StaticResource CTK.FontSize.Caption}"/>
    </Style>

    <Style x:Key="CTK.ContextMenu" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
        <Setter Property="MinWidth" Value="160"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource CTK.Brush.SurfaceElevated}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CTK.Brush.Border.Default}"/>
    </Style>

    <Style x:Key="CTK.MenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Foreground" Value="{DynamicResource CTK.Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="CTK.DialogFooter" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Margin" Value="{StaticResource CTK.Spacing.6}"/>
    </Style>

    <!-- Compatibility seam: legacy style keys now resolve to the shared CTK component interface. -->
    <Style x:Key="Style_PrimaryButton" TargetType="Button" BasedOn="{StaticResource CTK.Button.Primary}"/>
    <Style x:Key="Style_SecondaryButton" TargetType="Button" BasedOn="{StaticResource CTK.Button.Secondary}"/>
    <Style x:Key="Style_Button_Amber" TargetType="Button" BasedOn="{StaticResource CTK.Button.Warning}"/>
    <Style x:Key="Style_Button_Teal" TargetType="Button" BasedOn="{StaticResource CTK.Button.Primary}"/>
    <Style x:Key="Style_Button_Violet" TargetType="Button" BasedOn="{StaticResource CTK.Button.Secondary}"/>
    <Style x:Key="Style_DangerButton" TargetType="Button" BasedOn="{StaticResource CTK.Button.Danger}"/>
    <Style x:Key="Style_IconButton" TargetType="Button" BasedOn="{StaticResource CTK.IconButton}"/>
    <Style x:Key="Style_IconButton_Active" TargetType="ToggleButton" BasedOn="{StaticResource CTK.ToolButton}"/>
    <Style x:Key="Style_ToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource CTK.ToggleButton}"/>
</ResourceDictionary>
